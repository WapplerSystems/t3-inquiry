{
	"name": "wapplersystems/inquiry",
	"type": "typo3-cms-extension",
	"description": "The extension is a universal TYPO3 extension that allows visitors to create enquiries for quotes.",
	"keywords": [
		"TYPO3",
		"extension",
		"inquiry",
		"offer",
		"quote"
	],
	"homepage": "https://github.com/WapplerSystems/t3-inquiry",
	"authors": [
		{
			"name": "Sven Wappler",
			"email": "typo3@wappler.systems",
			"role": "Developer",
			"homepage": "https://wappler.systems"
		},
		{
			"name": "Ilja Melnicenko",
			"email": "typo3@wappler.systems",
			"role": "Developer",
			"homepage": "https://wappler.systems"
		}
	],
	"license": "GPL-2.0-or-later",
	"support": {
		"issues": "https://github.com/WapplerSystems/t3-inquiry/issues",
		"source": "https://github.com/WapplerSystems/t3-inquiry"
	},
	"require": {
		"typo3/cms-core": "^13.0",
		"typo3/cms-frontend": "^13.0",
		"typo3/cms-form": "^13.0",
		"mpdf/mpdf": "^8.3"
	},
	"autoload": {
		"psr-4": {
			"WapplerSystems\\Inquiry\\": "Classes"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "inquiry"
		}
	},
	"require-dev": {
		"typo3/testing-framework": "^8.0",
		"phpunit/phpunit": "^11.0"
	},
	"autoload-dev": {
		"psr-4": {
			"WapplerSystems\\Inquiry\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		}
	}
}
