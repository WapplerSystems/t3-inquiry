<?xml version="1.0" encoding="utf-8"?>
<T3DataStructure>
    <sheets>
        <options>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Mail Optionen</sheetTitle>
                </TCEforms>
                <el>
                    <settings.subject>
                        <label>LLL:EXT:inquiry/Resources/Private/Language/backend.xlf:flexform.subject</label>
                        <config>
                            <type>input</type>
                            <size>40</size>
                            <default>New inquiry</default>
                        </config>
                    </settings.subject>
                    <settings.recipients>
                        <section>1</section>
                        <type>array</type>
                        <title>LLL:EXT:inquiry/Resources/Private/Language/backend.xlf:flexform.recipients</title>
                        <el>
                            <container>
                                <title>LLL:EXT:inquiry/Resources/Private/Language/backend.xlf:flexform.recipient</title>
                                <type>array</type>
                                <el>
                                    <address>
                                        <label>
                                            LLL:EXT:inquiry/Resources/Private/Language/backend.xlf:flexform.recipient.emailaddress
                                        </label>
                                        <config>
                                            <type>input</type>
                                            <size>40</size>
                                            <eval>trim,email,required</eval>
                                        </config>
                                    </address>
                                    <name>
                                        <label>
                                            LLL:EXT:inquiry/Resources/Private/Language/backend.xlf:flexform.recipient.name
                                        </label>
                                        <config>
                                            <type>input</type>
                                            <size>40</size>
                                            <eval>trim,required</eval>
                                        </config>
                                    </name>
                                </el>
                            </container>
                        </el>
                    </settings.recipients>
                </el>
            </ROOT>
        </options>
    </sheets>
</T3DataStructure>
