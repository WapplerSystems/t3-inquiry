


plugin.tx_inquiry {


  view {
    # cat=plugin.tx_inquiry/file; type=string; label=Path to template root (FE)
    templateRootPath = EXT:inquiry/Resources/Private/Templates/
    # cat=plugin.tx_inquiry/file; type=string; label=Path to template partials (FE)
    partialRootPath = EXT:inquiry/Resources/Private/Partials/
    # cat=plugin.tx_inquiry/file; type=string; label=Path to template layouts (FE)
    layoutRootPath = EXT:inquiry/Resources/Private/Layouts/
  }

  settings {

    ajaxToggleItemTypeNum = 678934
    ajaxItemsListTypeNum = 678935
    ajaxRemoveItemTypeNum = 678936


    # cat=plugin.tx_inquiry/list/b; type=int; label=UID of the page containing the inquiry list
    listPageUid =

    # cat=plugin.tx_inquiry/debug/a; type=bool; label=Empty list after submission
    emptyList = 1

    design {



    }

  }


}
