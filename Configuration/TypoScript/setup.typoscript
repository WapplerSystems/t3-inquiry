# number musst be lower than the template

plugin.tx_inquiry {

  view {
    templateRootPaths {
      0 = EXT:inquiry/Resources/Private/Templates/
      1 = {$plugin.tx_inquiry.view.templateRootPath}
    }

    partialRootPaths {
      0 = EXT:inquiry/Resources/Private/Partials/
      1 = {$plugin.tx_inquiry.view.partialRootPath}
    }

    layoutRootPaths {
      0 = EXT:inquiry/Resources/Private/Layouts/
      1 = {$plugin.tx_inquiry.view.layoutRootPath}
    }

  }

  settings {

    ajaxToggleItemTypeNum = {$plugin.tx_inquiry.settings.ajaxToggleItemTypeNum}
    ajaxItemsListTypeNum = {$plugin.tx_inquiry.settings.ajaxItemsListTypeNum}
    ajaxRemoveItemTypeNum = {$plugin.tx_inquiry.settings.ajaxRemoveItemTypeNum}

    quickInquiryFormPageType = {$plugin.tx_inquiry.settings.quickInquiryFormPageType}

    emptyList = {$plugin.tx_inquiry.settings.emptyList}

  }
}

page.includeJSFooter.inquiry = EXT:inquiry/Resources/Public/JavaScript/inquiry.js
page.includeCSS.inquiry = EXT:inquiry/Resources/Public/CSS/inquiry.css

page.headerData {
  76890 = TEXT
  76890.typolink.parameter.data = TSFE:id
  76890.typolink.forceAbsoluteUrl = 1
  76890.typolink.returnLast = url
  76890.typolink.additionalParams = &type={$plugin.tx_inquiry.settings.ajaxToggleItemTypeNum}
  76890.wrap = <meta name="inquiry-toggle-item" content="|">

  76891 = TEXT
  76891.typolink.parameter.data = TSFE:id
  76891.typolink.forceAbsoluteUrl = 1
  76891.typolink.returnLast = url
  76891.typolink.additionalParams = &type={$plugin.tx_inquiry.settings.ajaxItemsListTypeNum}
  76891.wrap = <meta name="inquiry-items-list" content="|">

  76892 = TEXT
  76892.typolink.parameter.data = TSFE:id
  76892.typolink.forceAbsoluteUrl = 1
  76892.typolink.returnLast = url
  76892.typolink.additionalParams = &type={$plugin.tx_inquiry.settings.ajaxRemoveItemTypeNum}
  76892.wrap = <meta name="inquiry-remove-item" content="|">
}


plugin.tx_form {

  settings.yamlConfigurations {
    1745351874 = EXT:inquiry/Configuration/Yaml/FormSetup.yaml
  }

}


toggleItemInquiryPage = PAGE
toggleItemInquiryPage {
  typeNum = {$plugin.tx_inquiry.settings.ajaxToggleItemTypeNum}

  config {
    disableAllHeaderCode = 1
    xhtml_cleaning = none
    admPanel = 0
    debug = 0
    disablePrefixComment = 1
    metaCharset = utf-8
    additionalHeaders.10.header = Content-Type:application/json;charset=UTF-8
    disableBodyTag = 1
    no_cache = 1
  }

  10 = USER
  10.userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
  10.extensionName = Inquiry
  10.pluginName = ToggleItem
  10.vendorName = wapplersystems
}

itemsListInquiryPage = PAGE
itemsListInquiryPage {
  typeNum = {$plugin.tx_inquiry.settings.ajaxItemsListTypeNum}

  config {
    disableAllHeaderCode = 1
    xhtml_cleaning = none
    admPanel = 0
    debug = 0
    disablePrefixComment = 1
    metaCharset = utf-8
    additionalHeaders.10.header = Content-Type:application/json;charset=UTF-8
    disableBodyTag = 1
    no_cache = 1
  }

  10 = USER
  10.userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
  10.extensionName = Inquiry
  10.pluginName = ItemsList
  10.vendorName = wapplersystems
}

removeItemInquiryPage = PAGE
removeItemInquiryPage {
  typeNum = {$plugin.tx_inquiry.settings.ajaxRemoveItemTypeNum}

  config {
    disableAllHeaderCode = 1
    xhtml_cleaning = none
    admPanel = 0
    debug = 0
    disablePrefixComment = 1
    metaCharset = utf-8
    additionalHeaders.10.header = Content-Type:application/json;charset=UTF-8
    disableBodyTag = 1
    no_cache = 1
  }

  10 = USER
  10.userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
  10.extensionName = Inquiry
  10.pluginName = RemoveItem
  10.vendorName = wapplersystems
}

quickInquiryPage = PAGE
quickInquiryPage {
  typeNum = 989863

  config {
    disableAllHeaderCode = 1
    xhtml_cleaning = none
    admPanel = 0
    debug = 0
    disablePrefixComment = 1
    metaCharset = utf-8
    additionalHeaders.10.header = Content-Type:application/json;charset=UTF-8
    disableBodyTag = 1
    no_cache = 1
  }

  10 = CONTENT
  10 {
    table = tt_content
    select {
      pidInList = {$plugin.tx_inquiry.settings.quickFormPageUid}
      where = colPos=0
      orderBy = sorting
    }
  }
}
